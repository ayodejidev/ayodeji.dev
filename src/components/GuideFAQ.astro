---
interface Props { items: { question: string; answer: string }[]; }
const { items } = Astro.props;
---
{items.length > 0 && <section class="guide-faq" aria-labelledby="guide-faq"><h2 id="guide-faq">Frequently asked questions</h2>{items.map((item) => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}</section>}
