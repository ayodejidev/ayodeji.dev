---
import { navigation } from '../data/navigation';
import { site } from '../data/site';
import SiteSearch from './SiteSearch.astro';
const current = Astro.url.pathname;
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label={`${site.shortName} home`}>
      <img src="/logo.png" width="32" height="32" alt="" />
      <span>{site.shortName}</span>
    </a>
    <nav class="desktop-nav" aria-label="Primary">
      {navigation.map((item) => (
        <a href={item.href} aria-current={current === item.href || (item.href !== '/' && current.startsWith(item.href)) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>
    <div class="header-actions">
      <button class="icon-button search-button" type="button" data-search-open aria-label="Search site" title="Search (Ctrl+K)"><span aria-hidden="true">⌕</span></button>
      <button class="icon-button" type="button" data-theme-toggle aria-label="Toggle color theme" title="Toggle color theme">
        <span aria-hidden="true">◒</span>
      </button>
      <details class="mobile-menu">
        <summary aria-label="Open navigation" title="Menu">
          <svg class="menu-icon" aria-hidden="true" viewBox="0 0 24 24" width="22" height="22">
            <path d="M4 7h16M4 12h12M4 17h8" />
          </svg>
        </summary>
        <nav aria-label="Mobile">
          {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
      </details>
    </div>
  </div>
</header>
<SiteSearch />
