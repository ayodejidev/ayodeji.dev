---
interface Heading { depth: number; slug: string; text: string; }
interface Props { headings: Heading[]; readingProgress?: boolean; }
const headings = Astro.props.headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---
{headings.length > 0 && (
  <details class="article-toc toc-mobile">
    <summary>On this page</summary>
    <nav aria-label="Table of contents">
      <ol>{headings.map((heading) => <li class:list={[`toc-depth-${heading.depth}`]}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol>
    </nav>
  </details>
)}
{headings.length > 0 && (
  <aside class="article-toc toc-desktop" aria-label="Table of contents">
    <strong>Contents</strong>
    <ol>{headings.map((heading) => <li class:list={[`toc-depth-${heading.depth}`]}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol>
    {Astro.props.readingProgress && <div class="reading-progress" data-reading-progress hidden>
      <label for="reading-progress-meter">Reading progress <span data-reading-percent>0%</span></label>
      <progress id="reading-progress-meter" max="100" value="0">0%</progress>
    </div>}
  </aside>
)}
<script>
  import { enhanceArticles } from '../scripts/article-enhancements.js';
  enhanceArticles();
</script>
