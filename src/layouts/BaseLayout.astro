---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedAt?: Date;
  updatedAt?: Date;
  tags?: string[];
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = site.title,
  description = site.description,
  image = site.image,
  type = 'website',
  publishedAt,
  updatedAt,
  tags = [],
  jsonLd,
} = Astro.props;
const pageTitle = title === site.title ? title : `${title} | ${site.shortName}`;
const canonical = new URL(Astro.url.pathname, site.url);
const socialImage = new URL(image, site.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f3f6f9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#001838" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/icon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={`${site.shortName} RSS`} href="/rss.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.shortName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    {type === 'article' && publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    {type === 'article' && updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}
    {type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('theme');
        const dark = saved === 'dark' || (!saved && matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
      })();
    </script>
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <Header />
    <main id="content"><slot /></main>
    <Footer />
    <script is:inline>
      document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('theme', next);
      });

      (() => {
        const now = Date.now();
        const cards = [...document.querySelectorAll('[data-event-card][data-event-date]')];

        for (const element of document.querySelectorAll('[data-event-date]')) {
          const eventDate = Date.parse(element.dataset.eventDate ?? '');
          if (Number.isNaN(eventDate)) continue;
          const timing = eventDate >= now ? 'upcoming' : 'past';
          const status = element.querySelector('[data-event-status]');
          if (!status) continue;
          status.textContent = timing === 'upcoming'
            ? (element.matches('header') ? 'Upcoming talk' : 'Upcoming')
            : 'Past talk';
          status.classList.toggle('upcoming', timing === 'upcoming');
          status.classList.toggle('past', timing === 'past');
        }

        const groups = document.querySelectorAll('[data-event-group]');
        if (groups.length === 0) return;
        const lists = Object.fromEntries([...groups].map((group) => [group.dataset.eventGroup, group.querySelector('.card-list')]));
        cards
          .sort((a, b) => {
            const aDate = Date.parse(a.dataset.eventDate ?? '');
            const bDate = Date.parse(b.dataset.eventDate ?? '');
            const bothUpcoming = aDate >= now && bDate >= now;
            return bothUpcoming ? aDate - bDate : bDate - aDate;
          })
          .forEach((card) => {
            const timing = Date.parse(card.dataset.eventDate ?? '') >= now ? 'upcoming' : 'past';
            lists[timing]?.append(card);
          });
        for (const group of groups) group.hidden = group.querySelectorAll('[data-event-card]').length === 0;
      })();
    </script>
  </body>
</html>
