---
import { render } from 'astro:content';
import FeaturedCard from '../components/FeaturedCard.astro';
import PageHeader from '../components/PageHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getFeatured, getPage } from '../lib/content';
const page = await getPage('featured'); const { Content } = await render(page); const items = await getFeatured();
---
<BaseLayout title={page.data.title} description={page.data.description}>
  <PageHeader {...page.data} /><div class="shell content-page"><Content /></div>
  <section class="section shell"><div class="card-grid">{items.map((item) => <FeaturedCard item={item} />)}</div></section>
</BaseLayout>
