---
import { render } from 'astro:content';
import WritingList from '../../components/WritingList.astro';
import PageHeader from '../../components/PageHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getBlogPosts, getPage } from '../../lib/content';
const page = await getPage('blog');
const { Content } = await render(page);
const posts = await getBlogPosts();
---
<BaseLayout title={page.data.title} description={page.data.description}>
  <PageHeader {...page.data} />
  <div class="shell content-page"><Content /></div>
  <WritingList posts={posts} />
</BaseLayout>
