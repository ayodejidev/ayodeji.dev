---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { eventTiming, getBlogPosts, getEvents, getFeatured, getPage, getProjects, slugFor, topicLabel } from '../lib/content';
import { formatDate } from '../lib/format';
import { site } from '../data/site';

const [page, about, posts, allEvents, projects, appearances] = await Promise.all([
  getPage('home'), getPage('about'), getBlogPosts(), getEvents(), getProjects(), getFeatured(),
]);
const aboutParagraphs = (about.body ?? '').split(/\n\s*\n/u)
  .map((block) => block.replace(/\s+/gu, ' ').trim())
  .filter((block) => block && !block.startsWith('#') && !block.startsWith('-')).slice(0, 2);
const featured = posts.find((post) => post.data.featured) ?? posts[0];
const latest = posts.filter((post) => post.id !== featured?.id).slice(0, 3);
const now = new Date();
const upcoming = allEvents.filter((event) => eventTiming(event.data.date, now) === 'upcoming')
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime() || a.id.localeCompare(b.id));
const past = allEvents.filter((event) => eventTiming(event.data.date, now) === 'past');
const events = [...upcoming, ...past].slice(0, 3);
const selectedProjects = [...projects].sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || a.id.localeCompare(b.id)).slice(0, 2);
const selectedAppearances = appearances.slice(0, 2);
const personJsonLd = {
  '@context': 'https://schema.org', '@type': 'Person', name: site.name, url: site.url,
  image: new URL(site.image, site.url).toString(),
  jobTitle: 'Developer Advocate and Full-stack Software Engineer', sameAs: Object.values(site.social),
};
---
<BaseLayout jsonLd={personJsonLd}>
  <div class="homepage">
    <section class="home-intro shell" id="about" aria-labelledby="hero-title">
      <div class="home-intro-copy">
        <p class="eyebrow">{page.data.eyebrow}</p>
        <h1 id="hero-title">{page.data.title}</h1>
        {aboutParagraphs.map((paragraph) => <p class="home-about">{paragraph}</p>)}
        <div class="home-actions"><a class="button" href="/blog">Explore my writing →</a><a class="button secondary" href="/speaking">Talks &amp; speaking</a></div>
        <nav class="social-links" aria-label="Ayodeji on social media">
          <a href={site.social.github} aria-label="GitHub" title="GitHub" target="_blank" rel="me noopener noreferrer"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.87c-2.78.6-3.37-1.18-3.37-1.18-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.35 1.09 2.92.83.09-.65.35-1.09.64-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02A9.6 9.6 0 0 1 12 6.82a9.6 9.6 0 0 1 2.5.34c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.86v2.76c0 .27.18.58.69.48A10 10 0 0 0 12 2Z" /></svg></a>
          <a href={site.social.linkedin} aria-label="LinkedIn" title="LinkedIn" target="_blank" rel="me noopener noreferrer"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M6.5 8.25H3.25V21H6.5V8.25ZM4.87 3A1.88 1.88 0 1 0 4.9 6.76 1.88 1.88 0 0 0 4.87 3ZM21 13.7c0-3.84-2.05-5.62-4.79-5.62a4.14 4.14 0 0 0-3.75 2.07v-1.9H9.21V21h3.25v-6.31c0-1.66.32-3.28 2.39-3.28 2.04 0 2.07 1.91 2.07 3.39V21H21v-7.3Z" /></svg></a>
          <a href={site.social.x} aria-label="X" title="X" target="_blank" rel="me noopener noreferrer"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M18.9 3h3.68l-8.04 9.19L24 21h-7.41l-5.8-7.58L4.16 21H.47l8.61-9.84L0 3h7.59l5.24 6.93L18.9 3Zm-1.29 16h2.04L6.48 4.9H4.29L17.61 19Z" /></svg></a>
          <a href={site.social.substack} aria-label="Substack" title="Substack" target="_blank" rel="me noopener noreferrer"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M22.54 8.24H1.46V5.41h21.08v2.83ZM1.46 10.81V24L12 18.11 22.54 24V10.81H1.46ZM22.54 0H1.46v2.84h21.08V0Z" /></svg></a>
        </nav>

      </div>
      <figure class="home-portrait"><img src="/profile.jpg" width="879" height="879" alt="Portrait of Ayodeji Ogundare" /><figcaption>Building, learning, and sharing.</figcaption></figure>
    </section>
    {featured && <section class="home-section shell" aria-labelledby="featured-title">
      <div class="home-section-heading"><h2 id="featured-title">Featured writing</h2><span class="home-label">01 / In focus</span></div>
      <article class:list={['home-feature', { 'home-feature-text': !featured.data.cover }]}>
        {featured.data.cover && <a class="home-feature-media" href={`/blog/${slugFor(featured)}`} tabindex="-1" aria-hidden="true"><Image src={featured.data.cover} alt={featured.data.coverAlt ?? ''} widths={[480, 800, 1200]} sizes="(max-width: 679px) 100vw, 50vw" loading="lazy" /></a>}
        <div class="home-feature-copy"><p class="meta"><time datetime={featured.data.publishedAt.toISOString()}>{formatDate(featured.data.publishedAt)}</time>{featured.data.readingMinutes && ` · ${featured.data.readingMinutes} min read`}</p>
          <h3><a href={`/blog/${slugFor(featured)}`}>{featured.data.title}</a></h3><p>{featured.data.description}</p>
          <div class="home-topics">{featured.data.tags.slice(0, 3).map((tag) => <a href={`/topics/${tag}`}>{topicLabel(tag)}</a>)}</div>
          <a class="home-text-link" href={`/blog/${slugFor(featured)}`}>Read article →</a>
        </div>
      </article>
    </section>}
    {latest.length > 0 && <section class="home-section shell" aria-labelledby="writing-title">
      <div class="home-section-heading"><h2 id="writing-title">Latest writing</h2><a href="/blog">All articles →</a></div>
      <ul class="home-index">{latest.map((post) => <li class="home-index-row">
        <time class="meta" datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
        <article><h3><a href={`/blog/${slugFor(post)}`}>{post.data.title}</a></h3><p>{post.data.description}</p><div class="home-topics">{post.data.tags.slice(0, 3).map((tag) => <a href={`/topics/${tag}`}>{topicLabel(tag)}</a>)}</div></article>
        <span class="meta home-row-type">Article{post.data.readingMinutes && <><br />{post.data.readingMinutes} min read</>}</span>
      </li>)}</ul>
    </section>}
    {events.length > 0 && <section class="home-section shell" aria-labelledby="talks-title">
      <div class="home-section-heading"><h2 id="talks-title">Speaking &amp; community</h2><a href="/speaking">All talks →</a></div>
      <ul class="home-index">{events.map((event) => <li class="home-index-row" data-event-card data-event-date={event.data.date.toISOString()}>
        <time class="meta" datetime={event.data.date.toISOString()}>{formatDate(event.data.date)}</time>
        <article><span class:list={['talk-status', eventTiming(event.data.date, now)]} data-event-status>{eventTiming(event.data.date, now) === 'upcoming' ? 'Upcoming' : 'Past talk'}</span><h3><a href={`/speaking/${slugFor(event)}`}>{event.data.title}</a></h3><p>{event.data.event} · {event.data.location}</p>
          <div class="home-talk-links"><a href={`/speaking/${slugFor(event)}`}>Talk details →</a>{event.data.slidesUrl && <a href={event.data.slidesUrl}>Slides ↗</a>}{event.data.videoUrl && <a href={event.data.videoUrl}>Recording ↗</a>}{event.data.eventUrl && <a href={event.data.eventUrl}>Event ↗</a>}</div>
        </article><span class="meta home-row-type">Talk</span>
      </li>)}</ul>
    </section>}
    {(selectedProjects.length > 0 || selectedAppearances.length > 0) && <section class="home-section shell" aria-labelledby="work-title">
      <div class="home-section-heading"><h2 id="work-title">Selected work</h2><span class="home-label">Projects &amp; appearances</span></div>
      <div class="home-work-grid">
        {selectedProjects.map((project) => <article class="home-work"><p class="home-label">Project / Open source</p><h3><a href={project.data.link}>{project.data.title} ↗</a></h3><p>{project.data.description}</p><div class="home-topics">{project.data.tags.slice(0, 3).map((tag) => <a href={`/topics/${tag}`}>{topicLabel(tag)}</a>)}</div><a class="home-text-link" href={project.data.link}>Explore project ↗</a></article>)}
        {selectedAppearances.map((item) => <article class="home-work"><p class="home-label">{item.data.type}{item.data.publisher && ` / ${item.data.publisher}`}</p><h3><a href={item.data.url}>{item.data.title} ↗</a></h3><p>{item.data.description}</p><a class="home-text-link" href={item.data.url}>View appearance ↗</a></article>)}
      </div>
    </section>}
    <section class="home-newsletter shell" aria-labelledby="newsletter-title"><p class="home-label">Keep in touch</p><h2 id="newsletter-title">More things learned along the way.</h2><p>Notes on developer experience, open source, and the communities around them.</p><a class="button" href={site.social.substack}>Subscribe on Substack ↗</a></section>
  </div>
</BaseLayout>
