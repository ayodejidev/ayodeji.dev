---
import ArticleCard from '../components/ArticleCard.astro';
import EventCard from '../components/EventCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { eventTiming, getBlogPosts, getEvents, getPage } from '../lib/content';
import { site } from '../data/site';

const page = await getPage('home');
const about = await getPage('about');
const aboutParagraphs = (about.body ?? '')
  .split(/\n\s*\n/u)
  .map((block) => block.replace(/\s+/gu, ' ').trim())
  .filter((block) => block && !block.startsWith('#') && !block.startsWith('-'))
  .slice(0, 2);
const posts = (await getBlogPosts()).slice(0, 2);
const events = (await getEvents()).slice(0, 2);
const now = new Date();
const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: site.url,
  image: new URL(site.image, site.url).toString(),
  jobTitle: 'Developer Advocate and Full-stack Software Engineer',
  sameAs: Object.values(site.social),
};
---
<BaseLayout jsonLd={personJsonLd}>
  <section class="hero" id="about" aria-labelledby="hero-title">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">{page.data.eyebrow}</p>
        <h1 id="hero-title">{page.data.title}</h1>
        {aboutParagraphs.map((paragraph) => <p class="hero-about">{paragraph}</p>)}
        <div class="hero-actions"><a class="button" href="https://substack.com/@ayodejiogundare" target="_blank" rel="noopener noreferrer">Subscribe to newsletter</a><a class="button secondary" href="/blog">Read my blogs</a></div>
        <nav class="social-links" aria-label="Ayodeji on social media">
          <a href={site.social.github} aria-label="GitHub" title="GitHub" target="_blank" rel="me noopener noreferrer"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.87c-2.78.6-3.37-1.18-3.37-1.18-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.35 1.09 2.92.83.09-.65.35-1.09.64-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02A9.6 9.6 0 0 1 12 6.82a9.6 9.6 0 0 1 2.5.34c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.86v2.76c0 .27.18.58.69.48A10 10 0 0 0 12 2Z" /></svg></a>
          <a href={site.social.linkedin} aria-label="LinkedIn" title="LinkedIn" target="_blank" rel="me noopener noreferrer"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M6.5 8.25H3.25V21H6.5V8.25ZM4.87 3A1.88 1.88 0 1 0 4.9 6.76 1.88 1.88 0 0 0 4.87 3ZM21 13.7c0-3.84-2.05-5.62-4.79-5.62a4.14 4.14 0 0 0-3.75 2.07v-1.9H9.21V21h3.25v-6.31c0-1.66.32-3.28 2.39-3.28 2.04 0 2.07 1.91 2.07 3.39V21H21v-7.3Z" /></svg></a>
          <a href={site.social.x} aria-label="X" title="X" target="_blank" rel="me noopener noreferrer"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M18.9 3h3.68l-8.04 9.19L24 21h-7.41l-5.8-7.58L4.16 21H.47l8.61-9.84L0 3h7.59l5.24 6.93L18.9 3Zm-1.29 16h2.04L6.48 4.9H4.29L17.61 19Z" /></svg></a>
          <a href={site.social.substack} aria-label="Substack" title="Substack" target="_blank" rel="me noopener noreferrer"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M22.54 8.24H1.46V5.41h21.08v2.83ZM1.46 10.81V24L12 18.11 22.54 24V10.81H1.46ZM22.54 0H1.46v2.84h21.08V0Z" /></svg></a>
        </nav>
      </div>
      <div class="portrait-wrap"><img class="portrait" src="/profile.jpg" width="879" height="879" alt="Portrait of Ayodeji Ogundare" /></div>
    </div>
  </section>
  <section class="section shell home-section">
    <div class="section-heading"><h2>Latest articles</h2><a href="/blog">View all →</a></div>
    <div class="card-list">{posts.map((post) => <ArticleCard post={post} horizontal />)}</div>
  </section>
  <section class="section shell home-section">
    <div class="section-heading"><h2>Upcoming and recent talks</h2><a href="/speaking">View all →</a></div>
    <div class="card-list">{events.map((event) => <EventCard event={event} timing={eventTiming(event.data.date, now)} />)}</div>
  </section>
</BaseLayout>
